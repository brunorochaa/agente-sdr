# Secrets das Edge Functions
# Produção: supabase secrets set --env-file supabase/.env
# Local:    supabase functions serve --env-file supabase/.env
# (SUPABASE_URL e SUPABASE_SERVICE_ROLE_KEY são injetadas automaticamente pelo Supabase)

# Provedor de IA: gemini (padrão) | openai | claude
LLM_PROVIDER="gemini"

# Preencha só a chave do provedor escolhido
GEMINI_API_KEY=""
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""

# Opcional: troca o modelo (padrões: gemini-2.5-flash, gpt-5-mini, claude-opus-5-5)
# GEMINI_MODEL=""
# OPENAI_MODEL=""
# CLAUDE_MODEL=""

# Opcional: sem estes, o lead fica só no banco
PIPEFY_API_TOKEN=""
PIPEFY_PIPE_ID=""

# Opcional: sem estes, o agendamento funciona em modo demonstração
CAL_COM_API_KEY=""
CAL_COM_EVENT_TYPE_ID=""
